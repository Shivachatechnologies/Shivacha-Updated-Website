// Shivacha Technologies — admin, CRM and CMS schema (Neon PostgreSQL via Prisma).
// Connection string comes from DATABASE_URL (see prisma.config.ts); never hardcode it.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── enums ─────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  MARKETING_MANAGER
  SALES_MANAGER
  SEO_MANAGER
  CONTENT_MANAGER
  FINANCE_MANAGER
  PROJECT_MANAGER
  SUPPORT_MANAGER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  MEETING
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
  ON_HOLD
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Division {
  WEB3
  FINTECH
  DIGITAL_ASSETS
  AI
  CLOUD
  DIGITAL
}

enum FollowUpStatus {
  PENDING
  DONE
  CANCELLED
}

enum TechCategory {
  FRONTEND
  BACKEND
  MOBILE
  BLOCKCHAIN
  WEB3
  AI
  CLOUD
  DATABASE
  DEVOPS
  OTHER
}

enum NavMenu {
  HEADER
  FOOTER
  CTA
}

// ───────────────────────── identity ─────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  passwordHash      String
  role              Role      @default(CONTENT_MANAGER)
  active            Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions        Session[]
  resetTokens     PasswordResetToken[]
  assignedLeads   Lead[]               @relation("LeadAssignee")
  leadNotes       LeadNote[]
  leadActivities  LeadActivity[]
  followUps       FollowUp[]           @relation("FollowUpAssignee")
  createdFollowUp FollowUp[]           @relation("FollowUpCreator")
  auditLogs       AuditLog[]
  media           Media[]

  // Shivacha OS
  savedViews         SavedView[]
  ownedDeals         Deal[]                   @relation("DealOwner")
  createdProposals   Proposal[]               @relation("ProposalCreator")
  approvedProposals  Proposal[]               @relation("ProposalApprover")
  createdQuotes      Quote[]                  @relation("QuoteCreator")
  createdContracts   Contract[]               @relation("ContractCreator")
  ownedClients       Client[]                 @relation("ClientOwner")
  managedProjects    Project[]                @relation("ProjectManager")
  projectMemberships ProjectMember[]
  assignedTasks      Task[]                   @relation("TaskAssignee")
  createdTasks       Task[]                   @relation("TaskCreator")
  taskComments       TaskComment[]
  projectUpdates     ProjectUpdate[]
  createdInvoices    Invoice[]                @relation("InvoiceCreator")
  confirmedPayments  Payment[]                @relation("PaymentConfirmer")
  expenses           Expense[]
  assignedTickets    Ticket[]                 @relation("TicketAssignee")
  ticketMessages     TicketMessage[]
  communications     Communication[]
  calls              Call[]
  campaigns          Campaign[]
  automations        Automation[]
  notifications      Notification[]
  notificationPrefs  NotificationPreference[]
  aiExecutions       AIExecution[]
  aiConversations    AIConversation[]
  aiApprovalsAsked   AIApproval[]             @relation("AIApprovalRequester")
  aiApprovalsDecided AIApproval[]             @relation("AIApprovalDecider")
  kbArticles         KnowledgeArticle[]
  securityEvents     SecurityEvent[]
  twoFactor          TwoFactorMethod?
  activities         Activity[]
  documents          Document[]

  @@index([role])
  @@index([active])
}

/// Session id is the SHA-256 hash of the random token held in the HTTP-only cookie.
model Session {
  id         String   @id
  userId     String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Token id is the SHA-256 hash of the emailed token. Single use, short expiry.
model PasswordResetToken {
  id        String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  userAgent String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ───────────────────────── CRM ─────────────────────────

model Lead {
  id              String         @id @default(cuid())
  /// Human-readable id sent in emails and the Google Sheet (e.g. SHV-20260927-AB12).
  ref             String         @unique
  name            String
  company         String?
  email           String
  phone           String?
  country         String?
  service         String?
  product         String?
  budget          String?
  message         String?        @db.Text
  formType        String         @default("project")
  source          String?
  campaign        String?
  landingPage     String?
  referrer        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmTerm         String?
  utmContent      String?
  score           Int?
  scoreLabel      String?
  status          LeadStatus     @default(NEW)
  priority        LeadPriority   @default(MEDIUM)
  assignedToId    String?
  estimatedValue  Decimal?       @db.Decimal(14, 2)
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  archivedAt      DateTime?
  extra           Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // CRM 2.0 (additive, all optional)
  city            String?
  website         String?
  currency        Currency       @default(USD)
  lifecycleStage  LifecycleStage @default(LEAD)
  team            String?
  tags            String[]       @default([])
  /// Set when this lead was merged into another (the record is archived, never deleted).
  mergedIntoId    String?

  assignedTo     User?           @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  notes          LeadNote[]
  activities     LeadActivity[]
  followUps      FollowUp[]
  deals          Deal[]
  client         Client?
  proposals      Proposal[]
  communications Communication[]
  calls          Call[]
  tasks          Task[]

  @@index([email])
  @@index([status])
  @@index([priority])
  @@index([country])
  @@index([service])
  @@index([product])
  @@index([source])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([archivedAt, createdAt])
  @@index([lifecycleStage])
  @@index([archivedAt, status, createdAt])
  @@index([nextFollowUpAt])
  @@index([utmCampaign])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  authorId  String?
  body      String   @db.Text
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  actorId   String?
  type      String
  data      Json?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([type])
}

model FollowUp {
  id           String         @id @default(cuid())
  leadId       String
  assignedToId String?
  createdById  String?
  dueAt        DateTime
  note         String?        @db.Text
  status       FollowUpStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lead         Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   User?          @relation("FollowUpAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User?          @relation("FollowUpCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([assignedToId, status])
  @@index([leadId])
}

// ───────────────────────── CMS ─────────────────────────

model Service {
  id               String        @id @default(cuid())
  slug             String        @unique
  name             String
  division         Division
  shortDescription String?
  description      String?       @db.Text
  heroTitle        String?
  heroDescription  String?
  benefits         Json?
  features         Json?
  technologies     Json?
  deliverables     Json?
  process          Json?
  faqs             Json?
  ctaLabel         String?
  ctaHref          String?
  heroImage        String?
  gallery          Json?
  seoTitle         String?
  seoDescription   String?
  canonical        String?
  ogImage          String?
  status           ContentStatus @default(DRAFT)
  sortOrder        Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([division, sortOrder])
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  category        String?
  division        Division
  description     String?       @db.Text
  heroTitle       String?
  heroDescription String?
  screenshots     Json?
  mockups         Json?
  features        Json?
  modules         Json?
  techStack       Json?
  integrations    Json?
  architecture    Json?
  deployment      Json?
  customization   Json?
  timeline        String?
  demoCtaLabel    String?
  leadCtaLabel    String?
  relatedServices Json?
  faqs            Json?
  seoTitle        String?
  seoDescription  String?
  canonical       String?
  ogImage         String?
  status          ContentStatus @default(DRAFT)
  sortOrder       Int           @default(0)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
  @@index([division, sortOrder])
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  heroTitle       String?
  heroDescription String?
  content         String?       @db.Text
  ctaLabel        String?
  ctaHref         String?
  seoTitle        String?
  seoDescription  String?
  canonical       String?
  ogImage         String?
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  sections        PageSection[]

  @@index([status])
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  type      String
  data      Json
  order     Int      @default(0)
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model BlogPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  content        String?       @db.Text
  authorName     String?
  featuredImage  String?
  category       String?
  tags           String[]      @default([])
  readingTime    Int?
  seoTitle       String?
  seoDescription String?
  canonical      String?
  ogImage        String?
  status         ContentStatus @default(DRAFT)
  /// Publication time; a PUBLISHED post with a future date is scheduled.
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([category])
}

model CaseStudy {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  client         String?
  industry       String?
  challenge      String?       @db.Text
  solution       String?       @db.Text
  architecture   String?       @db.Text
  technologies   Json?
  deliverables   Json?
  results        String?       @db.Text
  images         Json?
  metrics        Json?
  testimonial    String?       @db.Text
  seoTitle       String?
  seoDescription String?
  canonical      String?
  ogImage        String?
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

model Industry {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  heroTitle       String?
  heroDescription String?
  description     String?       @db.Text
  services        Json?
  products        Json?
  technologies    Json?
  content         String?       @db.Text
  faqs            Json?
  seoTitle        String?
  seoDescription  String?
  canonical       String?
  ogImage         String?
  status          ContentStatus @default(DRAFT)
  sortOrder       Int           @default(0)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model Technology {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  category       TechCategory  @default(OTHER)
  description    String?       @db.Text
  website        String?
  seoTitle       String?
  seoDescription String?
  status         ContentStatus @default(DRAFT)
  sortOrder      Int           @default(0)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([category])
}

model Faq {
  id          String        @id @default(cuid())
  question    String
  answer      String        @db.Text
  category    String?
  serviceSlug String?
  productSlug String?
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category])
  @@index([serviceSlug])
  @@index([productSlug])
}

model Media {
  id           String   @id @default(cuid())
  /// Object-storage key (or local key in development).
  key          String   @unique
  url          String
  filename     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  caption      String?
  uploadedById String?
  createdAt    DateTime @default(now())
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([mimeType])
}

// ───────────────────────── site configuration ─────────────────────────

model NavigationItem {
  id        String           @id @default(cuid())
  menu      NavMenu
  label     String
  url       String
  parentId  String?
  order     Int              @default(0)
  active    Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  parent    NavigationItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  NavigationItem[] @relation("NavTree")

  @@index([menu, parentId, order])
}

/// Per-path SEO overrides for any public URL.
model SeoEntry {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String?
  description String?
  canonical   String?
  ogImage     String?
  noindex     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique
  destination String
  statusCode  Int      @default(308)
  active      Boolean  @default(true)
  hits        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

/// Non-secret site settings (company info, contact, Calendly URL, CTA labels, default SEO). Secrets stay in env vars.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
}

