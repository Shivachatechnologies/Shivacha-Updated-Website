# ─────────────────────────────────────────────────────────────────────────────
# Shivacha — production environment for a VPS (self-hosted `npm run build` + `npm start`)
#
# Copy to `.env.production` ON THE SERVER ONLY and fill in real values there. Never commit it.
# Every name below is read somewhere in the codebase (see docs/env-production-report.md for where).
#
# Uncommented lines   = needed for a working production site. Replace YOUR_VALUE_HERE.
# Commented lines (#) = optional. Uncomment only when you use that integration: most integrations
#                       count as "connected" as soon as the variable is non-empty, so never leave a
#                       placeholder in an uncommented optional line.
#
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time: set them before `npm run build`
# and rebuild after changing them. They must never hold a secret.
# ─────────────────────────────────────────────────────────────────────────────

# ───────────── Site (public, build time) ─────────────
# Canonical site URL: sitemap, Open Graph, email links, Twilio webhook base. Code default: https://shivacha.com
NEXT_PUBLIC_SITE_URL=YOUR_VALUE_HERE
# Calendly booking link. Code default: https://calendly.com/shivacha-sales
# NEXT_PUBLIC_CALENDLY_URL=YOUR_VALUE_HERE

# ───────────── Database: Neon PostgreSQL + Prisma (server-only) ─────────────
# Pooled Neon connection string (…-pooler…neon.tech). Used by the app at runtime and by migrations during `npm run build`.
DATABASE_URL=YOUR_VALUE_HERE
# Direct (non-pooled) connection to the SAME database, used only by `prisma migrate deploy`.
# If unset, a Neon "-pooler" DATABASE_URL is converted to its direct host automatically.
DATABASE_URL_UNPOOLED=YOUR_VALUE_HERE
# Alternative names for the direct URL, checked in this order before DATABASE_URL_UNPOOLED. Set at most one.
# DIRECT_DATABASE_URL=YOUR_VALUE_HERE
# POSTGRES_URL_NON_POOLING=YOUR_VALUE_HERE
# DIRECT_URL=YOUR_VALUE_HERE
# Max DB connections per server process. Code default: 5
# DATABASE_POOL_MAX=YOUR_VALUE_HERE
# Set to 1 to skip `prisma migrate deploy` during `npm run build`.
# SKIP_DB_MIGRATE=YOUR_VALUE_HERE
# Retries when another deploy holds the migration lock (P1002). Code default: 5
# MIGRATE_LOCK_RETRIES=YOUR_VALUE_HERE

# ───────────── Auth / security (server-only) ─────────────
# 32+ random characters. Encrypts admin two-factor (TOTP) secrets. Changing it disables existing 2FA enrolments.
APP_ENCRYPTION_KEY=YOUR_VALUE_HERE
# Bearer token for /api/cron/daily and /api/cron/workforce. Without it neither scheduler runs.
CRON_SECRET=YOUR_VALUE_HERE
# HMAC-signs outgoing automation webhooks (x-shivacha-signature). Unsigned without it.
AUTOMATION_WEBHOOK_SECRET=YOUR_VALUE_HERE

# ───────────── AI workforce, execution router, voice employees (server-only) ─────────────
# Anthropic key. Without it agents, tasks and voice employees return live data only (no AI output).
ANTHROPIC_API_KEY=YOUR_VALUE_HERE
# Daily company-wide AI budget in USD. Code default: 10
MAX_DAILY_AI_COST=YOUR_VALUE_HERE
# Per-request token ceiling across the tool loop. Code default: 150000
MAX_REQUEST_TOKENS=YOUR_VALUE_HERE
# Per background-task token ceiling. Code default: 400000
# MAX_TASK_TOKENS=YOUR_VALUE_HERE
# Default model (per-agent override in /admin/ai/agents). Code default: claude-opus-5
# AI_MODEL=YOUR_VALUE_HERE
# "true" enables Anthropic server-side web search for the Research agent (billed per search).
# AI_WEB_SEARCH=YOUR_VALUE_HERE
# Time zone for workforce schedules. Code default: Asia/Kolkata
# WORKFORCE_TIMEZONE=YOUR_VALUE_HERE
# Voice: server-side OpenAI transcription and speech. Browser speech works without it.
# OPENAI_API_KEY=YOUR_VALUE_HERE
# OPENAI_STT_MODEL=YOUR_VALUE_HERE   (code default: gpt-4o-mini-transcribe)
# OPENAI_TTS_MODEL=YOUR_VALUE_HERE   (code default: gpt-4o-mini-tts)

# ───────────── File / media uploads (server-only) ─────────────
# Production uploads need ONE of these; with neither, uploads fail with STORAGE_NOT_CONFIGURED.
# Option A: Vercel Blob read/write token (works from a VPS too).
BLOB_READ_WRITE_TOKEN=YOUR_VALUE_HERE
# Option B: set to 1 to store uploads on the server disk in public/uploads (serve /uploads from nginx; see report).
# ALLOW_LOCAL_UPLOADS=YOUR_VALUE_HERE

# ───────────── Email: lead notifications, support replies (server-only) ─────────────
LEAD_NOTIFY_TO=YOUR_VALUE_HERE
MAIL_FROM=YOUR_VALUE_HERE
# Job applications go here.
# HR_NOTIFY_TO=YOUR_VALUE_HERE
# Reply-To on support ticket emails.
# SUPPORT_EMAIL=YOUR_VALUE_HERE
# Option A: SMTP (Google Workspace App Password).
SMTP_USER=YOUR_VALUE_HERE
SMTP_PASS=YOUR_VALUE_HERE
# SMTP_HOST=YOUR_VALUE_HERE     (code default: smtp.gmail.com)
# SMTP_PORT=YOUR_VALUE_HERE     (code default: 465)
# SMTP_SECURE=YOUR_VALUE_HERE   (true/false; default true when port is 465)
# Option B: Gmail OAuth2 instead of SMTP_USER/SMTP_PASS.
# GMAIL_USER=YOUR_VALUE_HERE
# GMAIL_OAUTH_CLIENT_ID=YOUR_VALUE_HERE
# GMAIL_OAUTH_CLIENT_SECRET=YOUR_VALUE_HERE
# GMAIL_OAUTH_REFRESH_TOKEN=YOUR_VALUE_HERE

# ───────────── Spam protection: Cloudflare Turnstile ─────────────
# Set both or neither. The site key is public (build time); the secret key is server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_VALUE_HERE
# TURNSTILE_SECRET_KEY=YOUR_VALUE_HERE

# ───────────── Lead storage mirror / CRM webhook (server-only) ─────────────
# apps-script | sheets | file | none. Default: apps-script if GOOGLE_SHEETS_WEBHOOK_URL, sheets if GOOGLE_SHEETS_LEADS_ID, else file.
# LEAD_STORE=YOUR_VALUE_HERE
# LEADS_FILE=YOUR_VALUE_HERE   (file store path; default .data/leads.jsonl)
# GOOGLE_SHEETS_WEBHOOK_URL=YOUR_VALUE_HERE
# GOOGLE_SHEETS_WEBHOOK_SECRET=YOUR_VALUE_HERE
# GOOGLE_SHEETS_LEADS_ID=YOUR_VALUE_HERE
# GOOGLE_SHEETS_LEADS_TAB=YOUR_VALUE_HERE   (code default: Leads)
# GOOGLE_SERVICE_ACCOUNT_EMAIL=YOUR_VALUE_HERE
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=YOUR_VALUE_HERE
# CRM_WEBHOOK_URL=YOUR_VALUE_HERE
# CRM_WEBHOOK_SECRET=YOUR_VALUE_HERE

# ───────────── Payments + their webhooks (server-only) ─────────────
# STRIPE_SECRET_KEY=YOUR_VALUE_HERE
# STRIPE_WEBHOOK_SECRET=YOUR_VALUE_HERE
# RAZORPAY_KEY_ID=YOUR_VALUE_HERE
# RAZORPAY_KEY_SECRET=YOUR_VALUE_HERE
# RAZORPAY_WEBHOOK_SECRET=YOUR_VALUE_HERE

# ───────────── Calendly webhook (server-only) ─────────────
# Unsigned Calendly webhooks are rejected without it.
# CALENDLY_WEBHOOK_SIGNING_KEY=YOUR_VALUE_HERE

# ───────────── WhatsApp ─────────────
# Primary sales number, digits only with country code. Server var; next.config.ts copies it into
# NEXT_PUBLIC_WHATSAPP_SALES_NUMBER at build time. Code default: 918171133917
# WHATSAPP_SALES_NUMBER=YOUR_VALUE_HERE
# NEXT_PUBLIC_WHATSAPP_SALES_NUMBER=YOUR_VALUE_HERE
# NEXT_PUBLIC_WHATSAPP_US_NUMBER=YOUR_VALUE_HERE
# NEXT_PUBLIC_WHATSAPP_UK_NUMBER=YOUR_VALUE_HERE
# WhatsApp Business Cloud API (server-only)
# WHATSAPP_CLOUD_TOKEN=YOUR_VALUE_HERE
# WHATSAPP_PHONE_NUMBER_ID=YOUR_VALUE_HERE

# ───────────── Telephony (server-only) ─────────────
# TWILIO_ACCOUNT_SID=YOUR_VALUE_HERE
# TWILIO_AUTH_TOKEN=YOUR_VALUE_HERE
# TWILIO_PHONE_NUMBER=YOUR_VALUE_HERE
# TWILIO_WEBHOOK_BASE_URL=YOUR_VALUE_HERE   (default: NEXT_PUBLIC_SITE_URL)
# EXOTEL_SID=YOUR_VALUE_HERE
# EXOTEL_API_KEY=YOUR_VALUE_HERE
# EXOTEL_API_TOKEN=YOUR_VALUE_HERE
# EXOTEL_WEBHOOK_TOKEN=YOUR_VALUE_HERE

# ───────────── Visitor intelligence (server-only) ─────────────
# IPinfo token for company identification. Without it companies are never shown.
# IPINFO_TOKEN=YOUR_VALUE_HERE

# ───────────── Analytics tags (public, build time) ─────────────
# NEXT_PUBLIC_GA_ID=YOUR_VALUE_HERE
# NEXT_PUBLIC_META_PIXEL_ID=YOUR_VALUE_HERE
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=YOUR_VALUE_HERE
# NEXT_PUBLIC_GSC_VERIFICATION=YOUR_VALUE_HERE

# ───────────── Marketing data sources (server-only) ─────────────
# GA4_PROPERTY_ID=YOUR_VALUE_HERE
# GSC_SITE_URL=YOUR_VALUE_HERE
# META_ADS_ACCESS_TOKEN=YOUR_VALUE_HERE
# META_ADS_ACCOUNT_ID=YOUR_VALUE_HERE
# GOOGLE_ADS_DEVELOPER_TOKEN=YOUR_VALUE_HERE
# GOOGLE_ADS_CUSTOMER_ID=YOUR_VALUE_HERE
# LINKEDIN_ADS_ACCESS_TOKEN=YOUR_VALUE_HERE
# LINKEDIN_ADS_ACCOUNT_ID=YOUR_VALUE_HERE
