{
  "name": "shivacha-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db/migrate-on-build.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:content": "tsx scripts/check-content.ts",
    "check:demos": "tsx scripts/check-demos.ts",
    "test:routes": "tsx scripts/test-routes.ts",
    "leads:setup-sheet": "tsx scripts/setup-lead-sheet.ts",
    "leads:test-email": "tsx scripts/test-lead-email.ts",
    "qa:layout": "node scripts/qa/layout-qa.mjs",
    "test:clock": "tsx scripts/qa/check-world-clock.ts",
    "postinstall": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:verify": "tsx scripts/db/verify.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:import": "tsx scripts/db/import-content.ts",
    "admin:create": "tsx scripts/db/create-admin.ts",
    "test:admin": "tsx --conditions=react-server --test tests/admin/*.test.ts",
    "test:admin:e2e": "node tests/admin/e2e.mjs",
    "test:os": "tsx --require ./tests/os/server-only-shim.cjs --test tests/os/unit.test.ts",
    "test:ai": "tsx --require ./tests/os/server-only-shim.cjs --test tests/os/ai.test.ts",
    "test:workforce": "tsx --require ./tests/os/server-only-shim.cjs --test tests/os/workforce.test.ts",
    "test:unified": "tsx --require ./tests/os/server-only-shim.cjs --test tests/os/unified.test.ts",
    "test:router": "tsx --require ./tests/os/server-only-shim.cjs --test tests/os/router.test.ts",
    "test:voice": "tsx --test tests/os/voice-mic.test.ts",
    "test:unified:db": "tsx --require ./tests/os/server-only-shim.cjs --test tests/os/unified-db.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "framer-motion": "^13.4.4",
    "geist": "^1.7.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "simple-icons": "^16.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright-core": "1.56",
    "postcss": "^8.5.28",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
