# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://shivacha.com

# Analytics (all optional — scripts load only when set)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Lead routing (server-only). Form submissions are POSTed as JSON to this URL (CRM / automation webhook).
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# CAPTCHA readiness (Cloudflare Turnstile). When both are set, forms require a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
