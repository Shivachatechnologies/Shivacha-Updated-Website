# ───────────── Site ─────────────
# Public site URL (canonical URLs, sitemap, Open Graph, links in emails)
NEXT_PUBLIC_SITE_URL=https://shivacha.com

# ───────────── Calendly ─────────────
# Calendly booking link (defaults to https://calendly.com/shivacha-sales when unset)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/shivacha-sales

# ───────────── Lead emails (Google Workspace, server-only) ─────────────
# All notifications go to sales@shivacha.com (job applications to hr@shivacha.com).
LEAD_NOTIFY_TO=sales@shivacha.com
HR_NOTIFY_TO=hr@shivacha.com
MAIL_FROM="Shivacha Technologies <sales@shivacha.com>"

# Option A — Gmail SMTP with a Google Workspace App Password (sales@ account → Security → App passwords)
SMTP_USER=sales@shivacha.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Option B — Gmail OAuth2 (no password stored). Create an OAuth client in Google Cloud,
# authorise sales@shivacha.com for scope https://mail.google.com/ and paste the refresh token.
GMAIL_USER=sales@shivacha.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ───────────── Lead database (server-only) ─────────────
# Recommended: Google Sheet via Apps Script (docs/google-apps-script/leads.gs). No Google Cloud project needed.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# LEAD_STORE: apps-script | sheets | file | none.
# Default: apps-script when GOOGLE_SHEETS_WEBHOOK_URL is set, sheets when GOOGLE_SHEETS_LEADS_ID is set, else file.
LEAD_STORE=
# Alternative: Sheets API with a service account
# Google Sheet in your Workspace, shared (Editor) with the service account email below.
GOOGLE_SHEETS_LEADS_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON; keep the \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# File store location (self-hosted servers only; not writable on serverless hosts)
# LEADS_FILE=/var/lib/shivacha/leads.jsonl

# Optional: also forward every lead to a CRM / automation webhook (HMAC-SHA256 signed)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ───────────── Spam protection ─────────────
# Cloudflare Turnstile. When both are set, forms require a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────── Analytics (optional — scripts load only when set) ─────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# ───────────── WhatsApp (optional overrides; digits only, country code first) ─────────────
# Defaults live in data/siteConfig.ts (India +91 81711 33917, USA +1 334 846 9075, UK +44 7446 971836).
NEXT_PUBLIC_WHATSAPP_SALES_NUMBER=
NEXT_PUBLIC_WHATSAPP_US_NUMBER=
NEXT_PUBLIC_WHATSAPP_UK_NUMBER=

# ───────────── Admin panel, CRM & CMS (server-only) ─────────────
# Neon PostgreSQL connection string (use the pooled connection string on Vercel). Never commit the real value.
# Migrations run automatically during `npm run build` when this is set (prisma migrate deploy — never reset).
DATABASE_URL=
# Optional: max connections per server instance (default 5)
# DATABASE_POOL_MAX=5
# Set to 1 to skip `prisma migrate deploy` during build
# SKIP_DB_MIGRATE=
# Media library object storage (Vercel Blob read/write token). Required for uploads in production.
BLOB_READ_WRITE_TOKEN=
# First Super Admin: run `npm run admin:create -- --email you@shivacha.com --name "Your Name"`.
# The password is prompted for (hidden). ADMIN_PASSWORD may be exported for one-off CI use only — never commit it.

# ───────────── WhatsApp ─────────────
# Primary sales WhatsApp number, digits only with country code (e.g. 918171133917). Used for every wa.me link.
WHATSAPP_SALES_NUMBER=

# ───────────── Shivacha OS (all server-only; every integration shows "Not connected" until set) ─────────────
# Vercel preview deployments skip migrations unless this is 1 (production always runs `prisma migrate deploy`).
# MIGRATE_ON_PREVIEW=
# Protects /api/cron/daily (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`). Without it the scheduler never runs.
CRON_SECRET=
# 32+ random characters. Encrypts two-factor (TOTP) secrets. Changing it disables existing 2FA enrolments.
APP_ENCRYPTION_KEY=
# HMAC-signs outgoing automation webhooks (x-shivacha-signature: sha256=…).
AUTOMATION_WEBHOOK_SECRET=

# AI workforce (Anthropic Claude). Without a key agents return live data only — no AI output is simulated.
ANTHROPIC_API_KEY=
# Default model (per-agent override in /admin/ai/agents). Default: claude-opus-5
# AI_MODEL=claude-opus-5
# Daily company-wide AI budget in USD (default 10) and per-request token ceiling across the tool loop (default 150000).
MAX_DAILY_AI_COST=10
MAX_REQUEST_TOKENS=150000
# "true" enables Anthropic server-side web search for the Research agent (billed per search).
# AI_WEB_SEARCH=

# Payments — payments stay PENDING until a verified webhook or a finance manager confirms them.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Business Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Twilio Voice (click-to-call, call logging, IVR). Webhook base defaults to NEXT_PUBLIC_SITE_URL.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# TWILIO_WEBHOOK_BASE_URL=
# Exotel (India telephony)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_WEBHOOK_TOKEN=
# Calendly webhook signing key (meetings are logged automatically)
CALENDLY_WEBHOOK_SIGNING_KEY=

# Marketing data sources (spend/ROI appear only when connected or entered manually)
GA4_PROPERTY_ID=
GSC_SITE_URL=
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
LINKEDIN_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_ACCOUNT_ID=
