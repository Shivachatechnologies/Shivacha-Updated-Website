# ───────────── Site ─────────────
# Public site URL (canonical URLs, sitemap, Open Graph, links in emails)
NEXT_PUBLIC_SITE_URL=https://shivacha.com

# ───────────── Calendly ─────────────
# Your Calendly event link, e.g. https://calendly.com/shivacha/30min
# Until set, "Book a Call" falls back to the on-site meeting request form.
NEXT_PUBLIC_CALENDLY_URL=PASTE_MY_CALENDLY_LINK_HERE

# ───────────── Lead emails (Google Workspace, server-only) ─────────────
# All notifications go to sales@shivacha.com (job applications to hr@shivacha.com).
LEAD_NOTIFY_TO=sales@shivacha.com
HR_NOTIFY_TO=hr@shivacha.com
MAIL_FROM="Shivacha Technologies <sales@shivacha.com>"

# Option A — Gmail SMTP with a Google Workspace App Password (sales@ account → Security → App passwords)
SMTP_USER=sales@shivacha.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Option B — Gmail OAuth2 (no password stored). Create an OAuth client in Google Cloud,
# authorise sales@shivacha.com for scope https://mail.google.com/ and paste the refresh token.
GMAIL_USER=sales@shivacha.com
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ───────────── Lead database (server-only) ─────────────
# LEAD_STORE: sheets | file | none. Default: sheets when GOOGLE_SHEETS_LEADS_ID is set, else file.
LEAD_STORE=
# Google Sheet in your Workspace, shared (Editor) with the service account email below.
GOOGLE_SHEETS_LEADS_ID=
GOOGLE_SHEETS_LEADS_TAB=Leads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON; keep the \n escapes.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# File store location (self-hosted servers only; not writable on serverless hosts)
# LEADS_FILE=/var/lib/shivacha/leads.jsonl

# Optional: also forward every lead to a CRM / automation webhook (HMAC-SHA256 signed)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ───────────── Spam protection ─────────────
# Cloudflare Turnstile. When both are set, forms require a valid token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ───────────── Analytics (optional — scripts load only when set) ─────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
